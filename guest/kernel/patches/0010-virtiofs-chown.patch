+static inline bool fuse_inode_chown_uid(struct fuse_inode *fi, kuid_t *uid)
+{
+	if (!test_bit(FUSE_I_CHOWN_UID, &fi->state))
+		return false;
+	smp_rmb();
+	*uid = READ_ONCE(fi->chown_uid);
+	return true;
