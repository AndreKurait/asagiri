# Header: Asagiri shares the Mac's files with its VM over virtiofs, and Apple's
# virtiofs server tells the guest nothing when a file changes on the Mac, so
# inotify watchers in containers (Vite, webpack, nodemon, cargo watch) never
# saw a save made on the Mac. /proc/asagiri-fsnotify lets Asagiri's guest agent,
# which hears of those changes from the Mac, raise the fsnotify events Linux
# raises for a local change ("M\t/mnt/mac/…" → IN_MODIFY, C/A/D likewise).
# Paths are looked up beneath /mnt/mac only (no symlinks, no other mounts),
# nothing is written, and deleted or modified file names are dropped from
# the guest's dcache so lookups see replacements before Apple's timeout.
# Only the VM's agent may write (root, in the VM's first mount namespace:
# not a container).
--- a/fs/notify/Makefile
+++ b/fs/notify/Makefile
@@ -5,3 +5,5 @@
 obj-y			+= dnotify/
 obj-y			+= inotify/
 obj-y			+= fanotify/
+
+obj-$(CONFIG_FSNOTIFY)		+= asagiri_inject.o
--- /dev/null
+++ b/fs/notify/asagiri_inject.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * /proc/asagiri-fsnotify: changes made outside the VM, raised as fsnotify
+ * events inside it.
+ *
+ * Asagiri shares the Mac's files with its VM over virtiofs, mounted at
+ * /mnt/mac. Apple's virtiofs server tells the guest nothing when a file
+ * changes on the Mac, so inotify watchers in the VM (file watchers in
+ * containers) never see those changes. Asagiri's guest agent hears of them
+ * from the Mac and writes one line per change here, "OP\t/mnt/mac/PATH\n":
+ *
+ *   C  PATH was created          (IN_CREATE on its directory)
+ *   M  PATH was modified         (IN_MODIFY, then IN_CLOSE_WRITE, as a
+ *                                write and close in the VM raise)
+ *   A  PATH's attributes changed (IN_ATTRIB)
+ *   D  PATH was deleted          (IN_DELETE on its directory, IN_DELETE_SELF)
+ *
+ * Nothing is written. Deleted or modified cached file names are dropped
+ * so a lookup asks the Mac again rather than opening a deleted or
+ * replaced node until Apple's timeout. Directories and mount points stay.
+ * PATH is looked up beneath /mnt/mac only, crossing no symlink and no mount, and
+ * /mnt/mac must be the FUSE (virtiofs) share: a name can't lead anywhere
+ * else in the VM. Only the VM's own agent may write: root, in the VM's
+ * first mount namespace, so a container can't, even as root.
+ */
+#include <linux/dcache.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/fsnotify.h>
+#include <linux/init.h>
+#include <linux/magic.h>
+#include <linux/mount.h>
+#include <linux/namei.h>
+#include <linux/nsproxy.h>
+#include <linux/proc_fs.h>
+#include <linux/sched/task.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#define ASAGIRI_SHARE "/mnt/mac"
+#define ASAGIRI_SCOPED (LOOKUP_BENEATH | LOOKUP_NO_SYMLINKS | LOOKUP_NO_XDEV | LOOKUP_NO_MAGICLINKS)
+
+/* Expire a cached file name without unlinking or asking the Mac. Keep the
+ * returned reference through the fresh lookup so an in-place change
+ * preserves the watched inode. Leave directories and mount points alone. */
+static struct dentry *asagiri_expire(struct path *parent, struct qstr *name)
+{
+	struct dentry *child = try_lookup_noperm(name, parent->dentry);
+
+	if (IS_ERR_OR_NULL(child))
+		return child;
+	spin_lock(&child->d_lock);
+	if (d_really_is_positive(child) && !d_is_dir(child) && !d_mountpoint(child))
+		__d_drop(child);
+	spin_unlock(&child->d_lock);
+	return child;
+}
+
+/* The file was deleted outside: expire its cached name and notify its
+ * directory and any watcher that still holds its inode. */
+static int asagiri_deleted(struct path *parent, struct qstr *name)
+{
+	struct inode *dir = d_inode(parent->dentry);
+	struct dentry *child = asagiri_expire(parent, name);
+
+	if (IS_ERR(child))
+		return PTR_ERR(child);
+	if (child && d_really_is_positive(child)) {
+		struct inode *inode = d_inode(child);
+		__u32 mask = FS_DELETE;
+
+		if (S_ISDIR(inode->i_mode))
+			mask |= FS_ISDIR;
+		ihold(inode);
+		fsnotify_name(mask, inode, FSNOTIFY_EVENT_INODE, dir, name, 0);
+		fsnotify_inode(inode, FS_DELETE_SELF);
+		iput(inode);
+	} else {
+		fsnotify_name(FS_DELETE, dir, FSNOTIFY_EVENT_INODE, dir, name, 0);
+	}
+	dput(child);
+	return 0;
+}
+
+/* One change. `rel` is PATH below the share: no leading or trailing '/'. */
+static int asagiri_event(struct path *share, char op, char *rel)
+{
+	char *slash = strrchr(rel, '/');
+	struct path parent, target;
+	struct dentry *cached = NULL;
+	struct qstr name;
+	char *last;
+	int err;
+
+	if (slash) {
+		*slash = '\0';
+		err = vfs_path_lookup(share->dentry, share->mnt, rel, ASAGIRI_SCOPED | LOOKUP_DIRECTORY, &parent);
+		*slash = '/';
+		if (err)
+			return err;
+		last = slash + 1;
+	} else {
+		parent = *share;
+		path_get(&parent);
+		last = rel;
+	}
+	name = (struct qstr)QSTR_INIT(last, strlen(last));
+
+	if (op == 'D') {
+		err = asagiri_deleted(&parent, &name);
+		goto out;
+	}
+	if (op == 'M') {
+		/* Host atomic saves arrive as modifications. Refresh the name
+		 * before notifying watchers so their first reads see the new file. */
+		cached = asagiri_expire(&parent, &name);
+		if (IS_ERR(cached)) {
+			err = PTR_ERR(cached);
+			cached = NULL;
+			goto out;
+		}
+		if (!fsnotify_sb_has_watchers(share->dentry->d_sb)) {
+			err = 0;
+			goto out;
+		}
+	}
+	err = vfs_path_lookup(share->dentry, share->mnt, rel, ASAGIRI_SCOPED, &target);
+	if (err)
+		goto out;
+	switch (op) {
+	case 'C':
+		fsnotify_name(d_is_dir(target.dentry) ? FS_CREATE | FS_ISDIR : FS_CREATE,
+			      target.dentry, FSNOTIFY_EVENT_DENTRY, d_inode(parent.dentry), &name, 0);
+		break;
+	case 'M':
+		fsnotify_dentry(target.dentry, FS_MODIFY);
+		if (d_is_reg(target.dentry))
+			fsnotify_dentry(target.dentry, FS_CLOSE_WRITE);
+		break;
+	case 'A':
+		fsnotify_dentry(target.dentry, FS_ATTRIB);
+		break;
+	default:
+		err = -EINVAL;
+	}
+	path_put(&target);
+out:
+	dput(cached);
+	path_put(&parent);
+	return err;
+}
+
+/* PATH below the share, or NULL if the line names anything else. */
+static char *asagiri_relative(char *path)
+{
+	size_t n = strlen(ASAGIRI_SHARE);
+	char *rel;
+
+	if (strncmp(path, ASAGIRI_SHARE "/", n + 1))
+		return NULL;
+	rel = path + n + 1;
+	if (!rel[0] || rel[0] == '/' || rel[strlen(rel) - 1] == '/')
+		return NULL;
+	return rel;
+}
+
+static ssize_t asagiri_write(struct file *file, const char __user *ubuf,
+			  size_t count, loff_t *ppos)
+{
+	struct path share;
+	char *buf, *line, *next, *rel;
+	int err = 0;
+
+	if (current->nsproxy->mnt_ns != init_task.nsproxy->mnt_ns)
+		return -EPERM;
+	if (count == 0 || count > PATH_MAX + 4)
+		return -EINVAL;
+	if (kern_path(ASAGIRI_SHARE, 0, &share))
+		return -ENOENT;
+	if (share.dentry != share.mnt->mnt_root || share.dentry->d_sb->s_magic != FUSE_SUPER_MAGIC) {
+		path_put(&share);
+		return -EXDEV;
+	}
+	buf = memdup_user_nul(ubuf, count);
+	if (IS_ERR(buf)) {
+		path_put(&share);
+		return PTR_ERR(buf);
+	}
+	for (line = buf; line && *line; line = next) {
+		next = strchr(line, '\n');
+		if (next)
+			*next++ = '\0';
+		if (!line[0])
+			continue;
+		if (line[1] != '\t' || !(rel = asagiri_relative(line + 2))) {
+			err = -EINVAL;
+			continue;
+		}
+		/* Deletes and modifications expire names without watchers.
+		 * Other events still cost no lookups without a watcher. */
+		if (line[0] != 'D' && line[0] != 'M' && !fsnotify_sb_has_watchers(share.dentry->d_sb))
+			continue;
+		err = asagiri_event(&share, line[0], rel);
+	}
+	kfree(buf);
+	path_put(&share);
+	return err ? err : count;
+}
+
+static const struct proc_ops asagiri_fsnotify_ops = {
+	.proc_write = asagiri_write,
+	.proc_lseek = noop_llseek,
+};
+
+static int __init asagiri_fsnotify_init(void)
+{
+	proc_create("asagiri-fsnotify", 0200, NULL, &asagiri_fsnotify_ops);
+	return 0;
+}
+fs_initcall(asagiri_fsnotify_init);
