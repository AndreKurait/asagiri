<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The password prompt the window's setup checklist shows on a Linux host:
     `pkexec /usr/bin/asagiri host-access USER` starts Asagiri's engine and lets USER
     use it (crates/asagiri/src/hostaccess.rs). -->
<policyconfig>
  <vendor>Asagiri</vendor>
  <vendor_url>https://andrekurait.github.io/asagiri</vendor_url>
  <action id="dev.asagiri.host-access">
    <description>Set up Asagiri for an account</description>
    <message>Asagiri needs your password to start its engine and let your account run containers.</message>
    <icon_name>asagiri</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/asagiri</annotate>
  </action>
</policyconfig>
