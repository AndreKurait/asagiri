+static bool asagiri_cleanup_extraction(struct asagiri_extraction *extraction) {
+    /* Refuse a replaced name; never remove another invocation's directory. */
+    bool removed = asagiri_owned_extraction(extraction) && rm_recursive(extraction->path);
+    if (!removed)
+        fprintf(stderr, "Failed to clean up private extraction: %s\n", strerror(errno));
+    free(extraction->path);
+    extraction->path = NULL;
+    return removed;
 }
 
