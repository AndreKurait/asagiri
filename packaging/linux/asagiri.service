# Asagiri on a Linux host, as the .deb and .rpm install it: containers on this
# machine's kernel, no VM. Users in the `asagiri` group reach the API at
# unix:///run/asagiri/docker.sock:
#   docker context create asagiri --docker host=unix:///run/asagiri/docker.sock
# and, while no Docker engine has it, at /var/run/docker.sock too.
[Unit]
Description=Asagiri container engine
Documentation=https://runkiri.com
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/asagiri daemon
Environment=ASAGIRI_SOCKET=/run/asagiri/docker.sock
Environment=ASAGIRI_SOCKET_GROUP=asagiri
Environment=HOME=/var/lib/asagiri-daemon
# The daemon creates the cgroups its containers run in.
Delegate=yes
KillMode=mixed
Restart=on-failure
# Tools that ignore docker contexts (docker-py, Go's client.FromEnv,
# docker-java, Testcontainers, IDE plugins) look for /var/run/docker.sock
# (/run/docker.sock): when nothing is there, it links to Asagiri's socket, whose
# 0660 root:asagiri is what counts. Docker's docker.socket or dockerd replaces
# a link when it starts, so Docker keeps the path whenever it runs, and the
# link goes when Asagiri stops, if it is still Asagiri's.
ExecStartPost=-/bin/sh -c '[ "$$(readlink /run/docker.sock)" = /run/asagiri/docker.sock ] || [ -e /run/docker.sock ] || [ -L /run/docker.sock ] || ln -s /run/asagiri/docker.sock /run/docker.sock'
ExecStopPost=-/bin/sh -c '[ "$$(readlink /run/docker.sock)" != /run/asagiri/docker.sock ] || rm -f /run/docker.sock'
RuntimeDirectory=asagiri
# 0755: members of asagiri reach the socket (itself 0660 root:asagiri) through it.
RuntimeDirectoryMode=0755
StateDirectory=asagiri-daemon
StateDirectoryMode=0700
# What the daemon writes is for root and the asagiri group only (/var/lib/asagiri
# itself is 0710: asagiri-init sets that, and its own umask, when it starts).
UMask=0027

[Install]
WantedBy=multi-user.target
