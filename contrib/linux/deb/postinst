#!/bin/sh
# Asagiri's engine as a system service; whoever ran apt joins the asagiri group
# and gets the asagiri docker context.
set -e
if [ "$1" = configure ]; then
    getent group asagiri >/dev/null || addgroup --system asagiri
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ] && id "$SUDO_USER" >/dev/null 2>&1; then
        adduser "$SUDO_USER" asagiri >/dev/null || true
        # The CLI's context, made as that person so it lands in their ~/.docker.
        su - "$SUDO_USER" -c 'docker context inspect asagiri >/dev/null 2>&1 || docker context create asagiri --docker host=unix:///run/asagiri/docker.sock >/dev/null' || true
        su - "$SUDO_USER" -c 'docker context use asagiri >/dev/null' || true
        echo "Asagiri: $SUDO_USER is in the asagiri group. Log out and back in once for it to apply."
    else
        echo "Asagiri: add yourself to the asagiri group (sudo adduser \$USER asagiri), then log out and back in."
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable asagiri.service >/dev/null 2>&1 || true
        systemctl restart asagiri.service || true
    fi
fi
exit 0
